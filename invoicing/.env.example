# Copy to .env for local `npx trigger.dev@latest dev` runs.
# In production these are set in the trigger.dev dashboard under
# Project Settings → Environment Variables (per environment: dev/staging/prod).

# Supabase — service role key, NOT the anon key. Full access, server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Composio — account API key, and the connected-account id for Sophie's
# Outlook/Microsoft account (created once via Composio's connection flow, see README.md).
COMPOSIO_API_KEY=
COMPOSIO_OUTLOOK_CONNECTED_ACCOUNT_ID=
