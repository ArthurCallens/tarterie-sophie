# One-off admin/migration scripts — run locally, never deployed anywhere.
# Copy to .env.local and fill in real values.

# Same Supabase project as the frontend, but note this is SUPABASE_URL
# (no VITE_ prefix) since these scripts run in Node, not the browser.
SUPABASE_URL=

# Secret — service role key, bypasses Row Level Security. Get it from
# Supabase dashboard → Project Settings → API → service_role.
# Never commit the real value, never expose it to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
