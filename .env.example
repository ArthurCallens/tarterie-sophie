# Public — used by the app in the browser (Vite only exposes VITE_-prefixed vars to client code)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Secret — used only by scripts/migrate-products.mjs, run locally with `npm run migrate:products`.
# Never prefix this with VITE_ and never commit the real value: it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
